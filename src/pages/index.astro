---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Launchpad - Build. Ship. Win." description="The hackathon platform for builders who ship. Join 10,000+ developers building the future.">
  <!-- Hero Section -->
  <section class="min-h-screen flex items-center justify-center bg-gradient-to-b from-green-50 to-white dark:from-gray-900 dark:to-gray-950">
    <div class="container px-6 py-20">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 text-sm font-medium mb-8 animate-fade-in">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
          </span>
          <span>Launchpad v2.0 is live — faster, safer, built for winners</span>
        </div>

        <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold tracking-tight text-gray-900 dark:text-white mb-6 animate-slide-up">
          Build. <span class="text-green-600 dark:text-green-400">Ship.</span> Win.
        </h1>

        <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-300 mb-10 max-w-2xl mx-auto animate-slide-up" style="animation-delay: 100ms;">
          The hackathon platform designed for velocity. Zero-config deployments, real-time collaboration, and judging tools that actually work.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16 animate-slide-up" style="animation-delay: 200ms;">
          <a href="#register" class="btn btn-primary text-lg px-8 py-4">
            Register Your Team
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a href="#features" class="btn btn-secondary text-lg px-8 py-4">
            See How It Works
          </a>
        </div>

        <!-- Trust indicators -->
        <div class="flex flex-wrap items-center justify-center gap-8 text-gray-400 text-sm animate-fade-in" style="animation-delay: 300ms;">
          <span>Trusted by teams at</span>
          <div class="flex items-center gap-6 opacity-60">
            <span class="font-mono text-xs">Vercel</span>
            <span class="font-mono text-xs">Cloudflare</span>
            <span class="font-mono text-xs">Neon</span>
            <span class="font-mono text-xs">Astro</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-20 bg-white dark:bg-gray-950">
    <div class="container px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
          Everything you need to <span class="text-green-600 dark:text-green-400">ship fast</span>
        </h2>
        <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
          From registration to winner announcement — Launchpad handles the infrastructure so you focus on building.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <article class="card animate-fade-in">
          <div class="w-12 h-12 rounded-lg bg-green-100 dark:bg-green-900/30 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Zero-Config Deploy</h3>
          <p class="text-gray-600 dark:text-gray-300">Push to GitHub, get a live URL in seconds. Preview deployments for every PR. No Docker, no YAML, no headaches.</p>
        </article>

        <!-- Feature 2 -->
        <article class="card animate-fade-in" style="animation-delay: 100ms;">
          <div class="w-12 h-12 rounded-lg bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Real-Time Collaboration</h3>
          <p class="text-gray-600 dark:text-gray-300">Live cursors, shared terminal, synchronized editing. Your team codes together like you're in the same room.</p>
        </article>

        <!-- Feature 3 -->
        <article class="card animate-fade-in" style="animation-delay: 200ms;">
          <div class="w-12 h-12 rounded-lg bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Fair Judging</h3>
          <p class="text-gray-600 dark:text-gray-300">Blind review, rubric-based scoring, conflict-of-interest detection. Winners earn trust, not just prizes.</p>
        </article>

        <!-- Feature 4 -->
        <article class="card animate-fade-in" style="animation-delay: 300ms;">
          <div class="w-12 h-12 rounded-lg bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Time-Boxed Sprints</h3>
          <p class="text-gray-600 dark:text-gray-300">Built-in countdown, milestone checkpoints, auto-submission. Deadlines drive decisions, not stress.</p>
        </article>

        <!-- Feature 5 -->
        <article class="card animate-fade-in" style="animation-delay: 400ms;">
          <div class="w-12 h-12 rounded-lg bg-pink-100 dark:bg-pink-900/30 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-pink-600 dark:text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Instant Feedback</h3>
          <p class="text-gray-600 dark:text-gray-300">Automated code review, performance budgets, accessibility checks. Know your score before judges see it.</p>
        </article>

        <!-- Feature 6 -->
        <article class="card animate-fade-in" style="animation-delay: 500ms;">
          <div class="w-12 h-12 rounded-lg bg-teal-100 dark:bg-teal-900/30 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-teal-600 dark:text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Secure by Default</h3>
          <p class="text-gray-600 dark:text-gray-300">CSP, COOP/COEP, rate limiting, encrypted secrets. Your code and data stay yours.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-20 bg-gray-900 dark:bg-gray-950">
    <div class="container px-6">
      <div class="grid md:grid-cols-4 gap-8 text-center">
        <div class="animate-fade-in">
          <div class="text-4xl md:text-5xl font-bold text-green-400 mb-2">10,000+</div>
          <div class="text-gray-300">Builders</div>
        </div>
        <div class="animate-fade-in" style="animation-delay: 100ms;">
          <div class="text-4xl md:text-5xl font-bold text-green-400 mb-2">500+</div>
          <div class="text-gray-300">Hackathons</div>
        </div>
        <div class="animate-fade-in" style="animation-delay: 200ms;">
          <div class="text-4xl md:text-5xl font-bold text-green-400 mb-2">99.9%</div>
          <div class="text-gray-300">Uptime</div>
        </div>
        <div class="animate-fade-in" style="animation-delay: 300ms;">
          <div class="text-4xl md:text-5xl font-bold text-green-400 mb-2">< 60s</div>
          <div class="text-gray-300">Deploy Time</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section id="register" class="py-20 bg-white dark:bg-gray-950">
    <div class="container px-6">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
          Ready to <span class="text-green-600 dark:text-green-400">ship your best work</span>?
        </h2>
        <p class="text-lg text-gray-600 dark:text-gray-300 mb-8">
          Join the next hackathon. Registration opens in 30 seconds — no credit card, no commitment, just code.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="https://github.com/launchpad-marketing" target="_blank" rel="noopener noreferrer" class="btn btn-primary text-lg px-8 py-4">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.305-.536-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
            Star on GitHub
          </a>
          <a href="#register" class="btn btn-secondary text-lg px-8 py-4">
            Join the Waitlist
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-gray-900 dark:bg-gray-950 text-gray-400 py-12">
    <div class="container px-6">
      <div class="grid md:grid-cols-4 gap-8 mb-8">
        <div>
          <h3 class="font-bold text-white mb-4">Launchpad</h3>
          <p class="text-sm">The hackathon platform for builders who ship.</p>
        </div>
        <div>
          <h4 class="font-semibold text-white mb-4">Product</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="#features" class="hover:text-green-400 transition-colors">Features</a></li>
            <li><a href="#" class="hover:text-green-400 transition-colors">Pricing</a></li>
            <li><a href="#" class="hover:text-green-400 transition-colors">Changelog</a></li>
            <li><a href="#" class="hover:text-green-400 transition-colors">Roadmap</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-semibold text-white mb-4">Resources</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="#" class="hover:text-green-400 transition-colors">Documentation</a></li>
            <li><a href="#" class="hover:text-green-400 transition-colors">API Reference</a></li>
            <li><a href="#" class="hover:text-green-400 transition-colors">Community</a></li>
            <li><a href="#" class="hover:text-green-400 transition-colors">Blog</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-semibold text-white mb-4">Legal</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="#" class="hover:text-green-400 transition-colors">Privacy</a></li>
            <li><a href="#" class="hover:text-green-400 transition-colors">Terms</a></li>
            <li><a href="#" class="hover:text-green-400 transition-colors">Security</a></li>
            <li><a href="#" class="hover:text-green-400 transition-colors">Cookies</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-sm">© 2025 Launchpad. Built with Astro, Neon, and Tailwind.</p>
        <div class="flex items-center gap-6">
          <a
            href="https://github.com/obiriandrewm-create/launchpad-marketing"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Launchpad on GitHub (opens in a new tab)"
            class="hover:text-green-400 transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.305-.536-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          </a>
          <a
            href="https://twitter.com/launchpad"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Launchpad on X (opens in a new tab)"
            class="hover:text-green-400 transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/></svg>
          </a>
          <a
            href="https://discord.gg/launchpad"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Launchpad on Discord (opens in a new tab)"
            class="hover:text-green-400 transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.38-.425.765-.64 1.15a18.27 18.27 0 0 0-5.038 0 12.64 12.64 0 0 0-.657-1.149.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.675 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.083.083 0 0 0 .031.057 19.9 19.9 0 0 0 5.994 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.007-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01 10.196 10.196 0 0 0 .373.293.077.077 0 0 1-.006.127 13.087 13.087 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.645.77 1.255 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.418-4.477-.419-9.011-3.573-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333 1.005-2.419 2.157-2.419 1.168 0 2.156 1.096 2.156 2.42 0 1.333-.977 2.418-2.156 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333 1.005-2.419 2.157-2.419 1.152 0 2.136 1.096 2.136 2.42 0 1.333-.994 2.418-2.136 2.418z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </footer>
</Layout>